<p id="live-race" class="racer live"><span class="news">{{ text }}</span>{{#classes}}<span class="class-bar"><span class="label">{{ label }}</span><span class="meter" aria-hidden="true"><span class="fill" style="--share:{{ share }}"></span></span><span class="times">{{ times }}</span></span>{{#newest}}<span class="ticker"><span class="ticker-text">{{ . }}</span></span>{{/newest}}{{/classes}}{{?flare}}<canvas class="flare" id="flare-{{ done }}" aria-hidden="true"></canvas>{{/flare}}</p>
