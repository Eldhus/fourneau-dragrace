<div id="live-race" class="racer live"><span class="news">Racing now</span>
{{#lanes}}<div class="lane{{?failed}} failed{{/failed}}"><span class="label">{{ label }}</span><span class="name">{{ now }}</span><span class="soon">{{ soon }}</span><span class="count">{{ count }}</span>{{?stepping}}<span class="step{{?late}} late{{/late}}" aria-hidden="true"><span class="fill" id="fill-{{ fill }}" style="--from:{{ from }};--seconds:{{ seconds }}s"></span></span>{{/stepping}}<span class="track" aria-hidden="true">{{#track}}<span class="{{ . }}"></span>{{/track}}</span><span class="left">{{ left }}</span></div>
{{/lanes}}{{?flare}}<canvas class="flare" id="flare-{{ done }}" aria-hidden="true"></canvas>{{/flare}}</div>
