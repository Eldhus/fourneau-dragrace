<figure class="strip" data-chart="{{ strip.key }}"><span class="run-id">{{ strip.run }}</span><figcaption><b>{{ strip.title }}</b>{{ strip.summary }}<span class="variant">{{#strip.variant |part|}}<span>{{ part }}</span>{{/strip.variant}}</span></figcaption>
<div class="drag" role="list">
{{#strip.rows |row|}}<div class="row" role="listitem" title="{{ row.tip }}"><span class="name">{{ row.competitor }}</span><span class="track">{{?row.valid}}<span class="bar s-{{ row.competitor }}{{?row.hollow}} hollow{{/row.hollow}}" style="--share:{{ row.share }}"></span>{{?row.ranged}}<span class="whisker" style="--low:{{ row.low }};--high:{{ row.high }}" aria-hidden="true"></span>{{/row.ranged}}<span class="figures"><span class="value">{{ row.value }}</span><span class="p99" title="{{ row.p99_tip }}">{{ row.p99 }}</span></span>{{/row.valid}}{{^row.valid}}<span class="value {{?row.raced}}dnf{{/row.raced}}{{^row.raced}}na{{/row.raced}}">{{ row.value }}</span>{{/row.valid}}</span></div>
{{/strip.rows}}</div>
<details class="table"><summary>table</summary><table><thead><tr><th>competitor</th><th>req/s (best)</th><th>p95 ms (median)</th><th>p99 ms (median)</th><th>p99.9 ms (median)</th><th>rounds</th><th>spread %</th><th>server CPU %</th><th>loader CPU %</th><th>Mbit/s in / out</th><th>limited by</th><th>steal %</th><th>peak RSS</th></tr></thead><tbody>
{{#strip.table |line|}}<tr><td>{{ line.competitor }}</td>{{?line.valid}}<td>{{ line.rps }}</td><td>{{ line.p95 }}</td><td>{{ line.p99 }}</td><td>{{ line.p999 }}</td><td>{{ line.rounds }}</td><td>{{ line.spread }}</td><td>{{ line.cpu }}</td><td>{{ line.loader }}</td><td>{{ line.net }}</td><td>{{ line.limit }}</td><td>{{ line.steal }}</td><td>{{ line.rss }}</td>{{/line.valid}}{{^line.valid}}<td colspan="12">{{ line.note }}</td>{{/line.valid}}</tr>
{{/strip.table}}</tbody></table></details></figure>
