<figure class="strip" data-chart="{{ key }}"><figcaption><b>{{ title }}</b>{{ summary }}</figcaption>
<div class="drag" role="list">
{{#rows}}<div class="row" role="listitem" title="{{ tip }}"><span class="name">{{ competitor }}</span><span class="track">{{?valid}}<span class="bar s-{{ competitor }}{{?hollow}} hollow{{/hollow}}" style="--share:{{ share }}"></span>{{?ranged}}<span class="whisker" style="--low:{{ low }};--high:{{ high }}" aria-hidden="true"></span>{{/ranged}}<span class="figures"><span class="value">{{ value }}</span><span class="p99" title="p99 latency, the rounds' median">{{ p99 }}</span></span>{{/valid}}{{^valid}}<span class="value dnf">DNF</span>{{/valid}}</span></div>
{{/rows}}</div>
<details class="table"><summary>table</summary><table><thead><tr><th>competitor</th><th>req/s (best)</th><th>p95 ms (median)</th><th>p99 ms (median)</th><th>p99.9 ms (median)</th><th>rounds</th><th>spread %</th><th>server CPU %</th><th>loader CPU %</th><th>Mbit/s in / out</th><th>limited by</th><th>steal %</th><th>peak RSS</th></tr></thead><tbody>
{{#table}}<tr><td>{{ competitor }}</td>{{?valid}}<td>{{ rps }}</td><td>{{ p95 }}</td><td>{{ p99 }}</td><td>{{ p999 }}</td><td>{{ rounds }}</td><td>{{ spread }}</td><td>{{ cpu }}</td><td>{{ loader }}</td><td>{{ net }}</td><td>{{ limit }}</td><td>{{ steal }}</td><td>{{ rss }}</td>{{/valid}}{{^valid}}<td colspan="12">not valid: {{ note }}</td>{{/valid}}</tr>
{{/table}}</tbody></table></details></figure>
