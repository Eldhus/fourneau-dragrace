{{> Top}}<section id="latest" class="results" aria-live="polite">
{{#live |banner|}}<div class="live-wrap" data-init="@get('/race-live')">{{$LiveRace}}<div id="live-race" class="racer live"><span class="news">Racing now</span>
{{#banner.lanes |lane|}}<div class="lane{{?lane.failed}} failed{{/lane.failed}}"><span class="label">{{ lane.label }}</span><span class="name">{{ lane.now }}</span><span class="soon">{{ lane.soon }}</span><span class="count">{{ lane.count }}</span>{{?lane.stepping}}<span class="step{{?lane.late}} late{{/lane.late}}" aria-hidden="true"><span class="fill" id="fill-{{ lane.fill }}" style="--from:{{ lane.from }};--seconds:{{ lane.seconds }}s"></span></span>{{/lane.stepping}}<span class="track" aria-hidden="true">{{#lane.track |cell|}}<span class="{{ cell }}"></span>{{/lane.track}}</span><span class="left">{{ lane.left }}</span></div>
{{/banner.lanes}}{{?banner.flare}}<canvas class="flare" id="flare-{{ banner.done }}" aria-hidden="true"></canvas>{{/banner.flare}}</div>
{{/LiveRace}}</div>
{{/live}}{{#racer |news|}}<p class="racer"><span class="news">{{ news.text }}</span><span class="items"><span class="row">{{#news.items |item|}}<span class="item">{{ item }}</span>{{/news.items}}{{?news.countdown}}<span class="item countdown" data-zone="America/New_York" data-at="05:00">before tonight's check</span>{{/news.countdown}}</span></span></p>
{{/racer}}{{?ready}}<p class="run-meta"><span>Race <b>{{ id }}</b></span> <span>{{ started }}</span>{{?timed}} <span>{{ took }}</span>{{/timed}}</p>
<p class="run-meta">{{#commits |commit|}}<span>{{ commit.name }} <a href="{{ commit.url }}">{{ commit.short }}</a></span> {{/commits}}</p>
<ul class="legend" aria-label="Competitors">{{#competitors |competitor|}}<li><span class="swatch s-{{ competitor }}"></span><a href="/competitors">{{ competitor }}</a></li>{{/competitors}}<li><span class="swatch hollow-bar"></span>server not saturated</li></ul>
{{> RaceClasses}}{{/ready}}{{^ready}}<p class="pending">No race yet: the first nightly has not run.</p>{{/ready}}
</section>
<article class="prose">
<h2>How it runs</h2>
<ul>
<li>Nightly, when something raced has changed: fourneau, roux, a competitor, or the race itself. A change to this site alone does not race.</li>
<li>Fresh DigitalOcean droplets; <a href="https://github.com/hatoo/oha">oha</a> loads the server over the private network.</li>
</ul>
<p>Details: <a href="/workloads">Workloads</a>. To make one of these servers faster: <a href="/contribute">Contribute</a>.</p>
</article>
{{> Bottom}}
