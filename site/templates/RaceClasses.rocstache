<div id="race-classes">
<div class="tabbar"><nav class="tabs" aria-label="Server class">{{#tabs}}<a href="{{ href }}" data-on:click__prevent="{{ action }}"{{?current}} aria-current="page"{{/current}}>{{ label }}</a>{{/tabs}}</nav><nav class="tabs protocol" aria-label="Protocol">{{#sections}}<a href="{{ href }}" data-on:click__prevent="{{ action }}"{{?current}} aria-current="page"{{/current}}>{{ label }}</a>{{/sections}}</nav></div>
{{#classes}}<h2 class="class">{{ title }}</h2>
<dl class="machines">{{#machines}}<dt>{{ role }}</dt><dd>{{ text }}</dd>{{/machines}}</dl>
<p class="raw"><a href="/data/classes/{{ ../id }}/{{ name }}.json">this class's data</a>, as the page draws it</p>
<p class="intro">{{ intro }}</p>
<div class="strips">
{{#strips}}{{> Strip}}{{/strips}}</div>
{{#open}}<figure class="strip open"><figcaption><b>{{ title }}</b>{{ caption }}</figcaption>
<p class="axis-note y">&uarr; {{ measure }}</p>
<div class="chart-scroll"><svg class="chart" viewBox="0 0 720 260" role="img" aria-label="{{ title }}: {{ measure }} by offered requests per second">
{{#ticks_y}}<line class="grid" x1="72" x2="600" y1="{{ line_y }}" y2="{{ line_y }}"></line><text class="tick" x="64" y="{{ text_y }}">{{ label }}</text>
{{/ticks_y}}{{#ticks_x}}<text class="date" x="{{ x }}" y="250">{{ label }}</text>
{{/ticks_x}}{{#lines}}<path class="line s-{{ competitor }}" d="{{ path }}"></path>
{{#dots}}<circle class="point s-{{ ../competitor }}{{?hollow}} hollow{{/hollow}}" cx="{{ cx }}" cy="{{ cy }}" r="4"><title>{{ title }}</title></circle>
{{/dots}}<text class="end" x="{{ label_x }}" y="{{ label_y }}">{{ competitor }}</text>
{{/lines}}</svg></div><p class="axis-note">offered requests per second &rarr;</p>
<ul class="legend" aria-label="Lines">{{#lines}}<li><span class="swatch s-{{ competitor }}"></span>{{ competitor }}</li>{{/lines}}<li><span class="swatch hollow-dot"></span>the loader was the limit</li></ul></figure>
{{/open}}{{#h2c}}<section class="h2c"><h3 class="class">HTTP/2 without TLS</h3>
<p class="intro">Plaintext three ways: HTTP/2 by prior knowledge (h2c) against HTTP/1.1 is what HTTP/2 costs or gives; HTTPS against h2c is what TLS costs. No browser speaks h2c: it takes the protocol apart from TLS.</p>
<div class="strips">
{{#strips}}{{> Strip}}{{/strips}}<div class="table"><table><thead><tr><th>competitor</th><th>HTTP/1.1</th><th>h2c</th><th>HTTPS</th><th>HTTP/2</th><th>TLS</th></tr></thead><tbody>
{{#rows}}<tr><td>{{ competitor }}</td><td>{{ plain }}</td><td>{{ h2c }}</td><td>{{ tls }}</td><td>{{ http2_change }}</td><td>{{ tls_change }}</td></tr>
{{/rows}}</tbody></table></div></div></section>
{{/h2c}}{{/classes}}
</div>
