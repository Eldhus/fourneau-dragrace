<div id="race-classes">
<nav class="tabs" aria-label="Server class">{{#tabs}}<a href="{{ href }}" data-on:click__prevent="{{ action }}"{{?current}} aria-current="page"{{/current}}>{{ label }}</a>{{/tabs}}</nav>
{{#classes}}<h2 class="class">{{ title }}</h2>
<dl class="machines">{{#machines}}<dt>{{ role }}</dt><dd>{{ text }}</dd>{{/machines}}</dl>
<p class="raw"><a href="/data/classes/{{ ../id }}/{{ name }}.json">raw data</a> for this class, every round</p>
<div class="strips">
{{#strips}}<figure class="strip"><figcaption><b>{{ title }}</b>{{ summary }}</figcaption>
<div class="drag" role="list">
{{#rows}}<div class="row" role="listitem" title="{{ tip }}"><span class="name">{{ competitor }}</span><span class="track">{{?valid}}<span class="bar s-{{ competitor }}{{?hollow}} hollow{{/hollow}}" style="--share:{{ share }}"></span><span class="reach" style="--reach:{{ reach }}"></span>{{?ranged}}<span class="whisker" style="--low:{{ low }};--high:{{ high }}" aria-hidden="true"></span>{{/ranged}}<span class="value">{{ value }}</span>{{/valid}}{{^valid}}<span class="value dnf">DNF</span>{{/valid}}</span></div>
{{/rows}}</div>
<details class="table"><summary>table</summary><table><thead><tr><th>competitor</th><th>req/s (median)</th><th>p95 ms</th><th>p99 ms</th><th>p99.9 ms</th><th>rounds</th><th>spread %</th><th>server CPU %</th><th>loader CPU %</th><th>Mbit/s in / out</th><th>limited by</th><th>steal %</th><th>peak RSS</th></tr></thead><tbody>
{{#table}}<tr><td>{{ competitor }}</td>{{?valid}}<td>{{ rps }}</td><td>{{ p95 }}</td><td>{{ p99 }}</td><td>{{ p999 }}</td><td>{{ rounds }}</td><td>{{ spread }}</td><td>{{ cpu }}</td><td>{{ loader }}</td><td>{{ net }}</td><td>{{ limit }}</td><td>{{ steal }}</td><td>{{ rss }}</td>{{/valid}}{{^valid}}<td colspan="12">not valid: {{ note }}</td>{{/valid}}</tr>
{{/table}}</tbody></table></details></figure>
{{/strips}}</div>
{{#open}}<figure class="strip open"><figcaption><b>Under load: {{ title }}</b>p99 latency against the offered rate (open loop: requests arrive at a fixed rate whatever the server does). Each server is offered 50% to 120% of its own maximum above.</figcaption>
<div class="chart-scroll"><svg class="chart" viewBox="0 0 720 260" role="img" aria-label="{{ title }}: p99 latency by offered requests per second">
{{#ticks_y}}<line class="grid" x1="72" x2="600" y1="{{ line_y }}" y2="{{ line_y }}"></line><text class="tick" x="64" y="{{ text_y }}">{{ label }}</text>
{{/ticks_y}}{{#ticks_x}}<text class="date" x="{{ x }}" y="250">{{ label }}</text>
{{/ticks_x}}{{#lines}}<path class="line s-{{ competitor }}" d="{{ path }}"></path>
{{#dots}}<circle class="point s-{{ ../competitor }}{{?hollow}} hollow{{/hollow}}" cx="{{ cx }}" cy="{{ cy }}" r="4"><title>{{ title }}</title></circle>
{{/dots}}<text class="end" x="{{ label_x }}" y="{{ label_y }}">{{ competitor }}</text>
{{/lines}}</svg></div><p class="axis-note">offered requests per second &rarr;</p>
<ul class="legend" aria-label="Lines">{{#lines}}<li><span class="swatch s-{{ competitor }}"></span>{{ competitor }}</li>{{/lines}}<li><span class="swatch hollow-dot"></span>the loader was the limit</li></ul></figure>
{{/open}}{{/classes}}
</div>
