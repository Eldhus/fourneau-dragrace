{
  "title": "fourneau (Zig)",
  "language": "Zig",
  "framework": "fourneau: io_uring, a fiber per connection, one shard per core",
  "links": { "fourneau": "https://github.com/Eldhus/fourneau", "Zig": "https://ziglang.org" },
  "build": [
    { "cwd": "competitors/fourneau-zig", "argv": ["{zig}", "build", "-Doptimize=safe", "-Dcpu=baseline", "-p", "{out}/fourneau-zig-prefix"] },
    { "cwd": ".", "argv": ["cp", "{out}/fourneau-zig-prefix/bin/fourneau-zig", "{out}/fourneau-zig"] }
  ],
  "run": { "argv": ["{bin}", "--address", "{address}", "--port", "{port}"] }
}
