{
  "title": "roux",
  "language": "Roc",
  "framework": "roux: a Roc platform whose host is fourneau",
  "links": {
    "roux": "https://github.com/Eldhus/roux",
    "Roc": "https://www.roc-lang.org"
  },
  "build": [
    {
      "cwd": "{roux}",
      "argv": [
        "{zig}",
        "build",
        "platform"
      ]
    },
    {
      "cwd": "{roux}",
      "argv": [
        "{zig}",
        "build",
        "tools"
      ]
    },
    {
      "cwd": ".",
      "argv": [
        "cp",
        "workloads/conduit/schema.sql",
        "competitors/roux/db/schema.sql"
      ]
    },
    {
      "cwd": "competitors/roux",
      "argv": [
        "{roux}/zig-out/bin/roux-db",
        "gen",
        "db"
      ]
    },
    {
      "cwd": "competitors/roux",
      "argv": [
        "{roux}/zig-out/bin/rocstache-gen",
        "-o",
        "Menu.roc",
        "Menu.rocstache"
      ]
    },
    {
      "cwd": "competitors/roux",
      "argv": [
        "{roc}",
        "build",
        "main.roc",
        "--output={out}/roux"
      ]
    }
  ],
  "run": {
    "argv": [
      "{bin}"
    ],
    "env": {
      "ROUX_ADDRESS": "{address}",
      "ROUX_DATABASE": "{db}"
    },
    "fixed_port": 8080
  }
}
