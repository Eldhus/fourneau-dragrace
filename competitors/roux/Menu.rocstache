{{%
## The race's menu: the prices are numbers, so the contract is declared.
Ctx : { dishes : List({ name : Str, price : U32 }) }
%}}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Menu</title></head>
<body>
<h1>Menu</h1>
<table>
<tr><th>Dish</th><th>Price</th></tr>
{{#dishes}}<tr><td>{{ name }}</td><td>{{ price }}</td></tr>
{{/dishes}}</table>
</body>
</html>
