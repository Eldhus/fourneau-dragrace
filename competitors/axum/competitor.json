{
  "title": "axum on tokio",
  "language": "Rust",
  "framework": "axum 0.8 on tokio's multi-threaded runtime",
  "links": { "axum": "https://github.com/tokio-rs/axum", "tokio": "https://tokio.rs" },
  "build": [
    { "cwd": "competitors/axum", "argv": ["cargo", "build", "--release", "--locked"] },
    { "cwd": ".", "argv": ["cp", "competitors/axum/target/release/dragrace-axum", "{out}/axum"] }
  ],
  "run": { "argv": ["{bin}", "--address", "{address}", "--port", "{port}"] }
}
