package main

import "strconv"

// The catalog workload: a bigger page, compiled to Go by templ: sections
// over a record, lists nested in lists, a table of 128 rows, conditions,
// empty lists, raw HTML and formatting functions. The reference is
// workloads/catalog.html; templ writes no line break of its own between
// elements, so the reference's are written out, each before its line.
templ catalogPage(c Catalog) {
	<!DOCTYPE html>
	{ "\n" }
	<html lang="en">
		{ "\n" }
		<head><meta charset="utf-8"/><title>{ c.Title }</title></head>
		{ "\n" }
		<body>
			{ "\n" }
			<h1>{ c.Title }</h1>
			{ "\n" }
			<p>@templ.Raw(c.Note)</p>
			{ "\n" }
			<p>
				{ c.Shop.Name }, { c.Shop.City }
				if c.Shop.Open {
					(open)
				} else {
					(closed)
				}
			</p>
			if !c.Closed {
				{ "\n" }
				<p>Open today.</p>
			}
			if len(c.Specials) == 0 {
				{ "\n" }
				<p>No specials.</p>
			}
			{ "\n" }
			<ul>
				for _, offer := range c.Offers {
					{ "\n" }
					<li>{ offer.What }: { pct(offer.Off) } off</li>
				}
				{ "\n" }
			</ul>
			if len(c.Offers) == 0 {
				{ "\n" }
				<p>No offers.</p>
			}
			{ "\n" }
			<p>{ plural(len(c.Groups), "group", "groups") }, { plural(len(c.Rows), "row", "rows") }, { kr(c.Total) } { c.Currency } in stock</p>
			for _, g := range c.Groups {
				{ "\n" }
				<h2>{ g.Name }</h2>
				<p>
					for _, m := range g.Members {
						{ m };
					}
				</p>
			}
			{ "\n" }
			<table>
				for _, row := range c.Rows {
					{ "\n" }
					<tr class={ level(row.Stock), templ.KV("hot", row.Hot) }>
						<td>{ strconv.FormatUint(uint64(row.ID), 10) } { row.Name }</td>
						<td>
							{ stock(row.Stock) }
							if len(row.Tags) == 0 {
								-
							} else {
								for _, t := range row.Tags {
									<i>{ t }</i>
								}
							}
						</td>
						<td>
							if row.OnSale {
								<s>{ kr(row.Price) }</s>
								{ kr(sale(row.Price, row.Discount)) }
							} else {
								{ kr(row.Price) }
							}
							{ c.Currency }
						</td>
						<td>{ date(row.Added) } { weight(row.Grams) }</td>
					</tr>
				}
				{ "\n" }
			</table>
			{ "\n" }
		</body>
		{ "\n" }
	</html>
	{ "\n" }
}
