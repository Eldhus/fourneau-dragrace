package main

import "strconv"

// The templates workload: the menu, compiled to Go by templ and rendered per
// request; it escapes every value. The reference is workloads/menu.html;
// templ writes no line break of its own between elements, so the
// reference's are written out, each before its line.
templ menuPage(dishes []Dish) {
	<!DOCTYPE html>
	{ "\n" }
	<html lang="en">
		{ "\n" }
		<head><meta charset="utf-8"/><title>Menu</title></head>
		{ "\n" }
		<body>
			{ "\n" }
			<h1>Menu</h1>
			{ "\n" }
			<table>
				{ "\n" }
				<tr><th>Dish</th><th>Price</th></tr>
				for _, dish := range dishes {
					{ "\n" }
					<tr><td>{ dish.Name }</td><td>{ strconv.Itoa(dish.Price) }</td></tr>
				}
				{ "\n" }
			</table>
			{ "\n" }
		</body>
		{ "\n" }
	</html>
	{ "\n" }
}
