[Unit]
Description=the dragrace site (roux)
After=network-online.target dragrace-site-https.socket dragrace-site-http.socket
Wants=network-online.target
Requires=dragrace-site-https.socket dragrace-site-http.socket
ConditionPathExists=/opt/dragrace-site/current/dragrace-site
OnFailure=dragrace-site-crashed.service
[Service]
Sockets=dragrace-site-https.socket dragrace-site-http.socket
User=site
StateDirectory=dragrace-site
StateDirectoryMode=0700
WorkingDirectory=/var/lib/dragrace-site
Environment=ROUX_ADDRESS=0.0.0.0
Environment=ROUX_REDIRECT_PORT=80
Environment=ROUX_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
Environment=ROUX_ACME_IDENTIFIER=fourneau.y2kbugger.com
Environment=ROUX_ACME_STATE=/var/lib/dragrace-site
Environment=ROUX_ACME_PROFILE=shortlived
ExecStart=/opt/dragrace-site/current/dragrace-site
CapabilityBoundingSet=
IPAddressDeny=100.64.0.0/10 fd7a:115c:a1e0::/48
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitNOFILE=65536
MemoryMax=256M
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
